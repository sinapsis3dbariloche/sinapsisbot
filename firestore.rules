rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lucaspassa@gmail.com' || 
        request.auth.token.email == 'maru.crespo.arg@gmail.com' || 
        request.auth.token.email == 'sinapsis3dbariloche@gmail.com' ||
        // Fallback for custom password login when Google Auth is restricted by domains
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---

    function isValidStock(data) {
      return data.keys().hasAll(['id', 'color', 'type', 'closedCount', 'openCount']) &&
             data.id is string &&
             data.color is string &&
             data.color.size() <= 100 &&
             data.type in ['PLA', 'PET-G'] &&
             data.closedCount is number &&
             data.openCount is number;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'contactName', 'phone', 'email', 'street', 'number', 'city', 'cuit', 'taxCondition', 'createdAt']) &&
             data.id is string &&
             data.name is string &&
             data.name.size() <= 200 &&
             data.createdAt is string;
    }

    function isValidRemito(data) {
      return data.keys().hasAll(['id', 'number', 'customerId', 'customerName', 'total', 'status', 'amountPaid', 'items', 'date', 'createdAt']) &&
             data.id is string &&
             data.number is string &&
             data.customerId is string &&
             data.customerName is string &&
             data.total is number &&
             data.status in ['Pendiente', 'Parcial', 'Pagado'] &&
             data.amountPaid is number &&
             data.items is list &&
             data.createdAt is string &&
             (!('isDraft' in data) || data.isDraft is bool);
    }

    function isValidPrinter(data) {
      return data.keys().hasAll(['id', 'name', 'model', 'hasAMS', 'history']) &&
             data.id is string &&
             data.name is string &&
             data.model is string &&
             data.hasAMS is bool &&
             data.history is list;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['id', 'name', 'street', 'number', 'city', 'createdAt']) &&
             data.id is string &&
             data.name is string &&
             data.street is string &&
             data.number is string &&
             data.city is string &&
             data.createdAt is string;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'date', 'supplierId', 'supplierName', 'items', 'total', 'createdAt']) &&
             data.id is string &&
             data.date is string &&
             data.supplierId is string &&
             data.supplierName is string &&
             data.items is list &&
             data.total is number &&
             data.createdAt is string &&
             (!('isDraft' in data) || data.isDraft is bool);
    }

    // --- Collection Routes ---

    match /stock/{itemId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(itemId) && isValidStock(request.resource.data);
      allow update: if isAdmin() && isValidStock(request.resource.data);
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(customerId) && isValidCustomer(request.resource.data);
      allow update: if isAdmin() && isValidId(customerId) && isValidCustomer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(supplierId) && isValidSupplier(request.resource.data);
      allow update: if isAdmin() && isValidId(supplierId) && isValidSupplier(request.resource.data);
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(expenseId) && isValidExpense(request.resource.data);
      allow update: if isAdmin() && isValidExpense(request.resource.data);
      allow delete: if isAdmin();
    }

    match /remitos/{remitoId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(remitoId) && isValidRemito(request.resource.data);
      allow update: if isAdmin() && isValidRemito(request.resource.data);
      allow delete: if isAdmin();
    }

    match /printers/{printerId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(printerId) && isValidPrinter(request.resource.data);
      allow update: if isAdmin() && isValidPrinter(request.resource.data);
      allow delete: if isAdmin();
    }

    match /config/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if isVerified();
    }

    match /authorized_users/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
